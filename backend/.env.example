# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=shubham_acrylic

# Auth
JWT_SECRET=change-this-to-a-strong-secret

# AWS S3 (required for production image uploads)
