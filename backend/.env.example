# ── Server Configuration ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MySQL Database Settings ───────────────────────────────────────────────────
DB_NAME=graphictees
DB_USER=root
DB_PASSWORD=123456
DB_HOST=localhost
DB_PORT=3306

# ── JWT Secret Key ─────────────────────────────────────────────────────────────
JWT_SECRET=astitvacreationssecretkey_change_in_production

# ── CORS Origins ───────────────────────────────────────────────────────────────
CORS_ORIGIN=https://astitvacreations.shop,https://www.astitvacreations.shop,https://admin.astitvacreations.shop,https://api.astitvacreations.shop,http://localhost:5173,http://localhost:5174

# ── Optional: Master Admin (Hardcoded DB Bypass) ──────────────────────────────
# MASTER_ADMIN_EMAIL=master@astitvacreations.shop
# MASTER_ADMIN_PASSWORD=supersecretmasterpassword

# ── AWS S3 Storage Settings (Optional - leave empty for local disk uploads) ───
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=astitva-creations-media

# ── Email (SMTP) – used for order OTP verification & order notifications ──────
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-char App Password from Google Account → Security>
# Hostinger / Zoho / Brevo etc. work the same way with their SMTP details.
# If left empty in development, OTP codes are printed in the server console.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Astitva Creations <orders@astitvacreations.shop>"
